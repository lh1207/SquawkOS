{
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "semi": ["error", "always"],
    "array-bracket-spacing": ["error", "always"],
    "no-const-assign": "error",
    "indent": ["error", 2],
    "quotes": ["error", "double"],
    "no-console": "off",
    "no-unused-vars": "off"
  },
  "env": {
    "node": true,
    "es6": true,
    "jest": true,
    "browser": true
  },
  "globals": {
    "Phaser": "readonly",
    "game": "readonly"
  },
  "overrides": [
    {
      "files": ["__tests__/**/*"],
      "env": {
        "jest": true
      }
    }
  ]
}
